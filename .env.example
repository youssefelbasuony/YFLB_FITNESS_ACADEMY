# Copy this file to .env.local or run npm run db:setup to initialize local secrets.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
DATABASE_PROVIDER=sqlite
DATABASE_PATH=data/yflb.sqlite
# Deployment uses the Supabase pooler URL (never commit its value).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
# Server-only Supabase Storage credentials; never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=yflb-training-videos
# Safe browser values. The publishable key is intended for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set this to the exact email address used by the YFLB owner account.
ADMIN_EMAIL=
# ADMIN_ACCESS_KEY is generated in .env.local on first local setup.
# Hosted deployments must provide a private random value of at least 32 characters.
