.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.vercel
.npmrc.local
.secrets/
secrets/
credentials/
credentials.json
credentials.*.json
service-account*.json
*-service-key*.json
*.pem
*.key
*.p12
*.pfx

