*.orig
backups/
backup/
database-backups/

# Archives and large local bundles
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Runtime logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
*.tmp
*.temp
tmp/
temp/
.scratch/

# Private uploaded media is not source code; public catalog content stays tracked.
/public/uploads/videos/*
!/public/uploads/videos/.gitkeep

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
